{
    "name": "marcosanz/translatethis",
    "description": "A Docker demo app for learning PHP",
    "minimum-stability": "dev",
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Sanz",
            "email": "cotesamarco@gmail.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "symfony/cache": "^6.1",
        "predis/predis": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "App\\":"src"
        }
    },
    "scripts":{
        "run-phpunit": "vendor/bin/phpunit"
    }
}